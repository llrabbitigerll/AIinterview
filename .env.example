# =====================================================
# AI Mock Interview Server - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your actual values

# ── LLM Provider Selection ───────────────────────────
# Options: "openai" | "qwen" | "moonshot" | "anthropic"
# Recommended: "qwen" for best cost-performance ratio (¥0.58/session vs ¥1.11)
LLM_PROVIDER=qwen
LLM_FALLBACK_PROVIDERS=["openai"]

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL_STRONG=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Alibaba Qwen (通义千问) ──────────────────────────
# Get your free 1M tokens (90 days): https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_STRONG=qwen3.5-plus
QWEN_MODEL_FAST=qwen-flash

# ── Moonshot Kimi (月之暗面) ─────────────────────────
# Get API key: https://platform.moonshot.cn/
MOONSHOT_API_KEY=sk-xxx
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL_STRONG=kimi-k2.5
MOONSHOT_MODEL_FAST=kimi-k2.5

# ── Anthropic Claude ─────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── ASR ──────────────────────────────────────
ASR_PROVIDER=azure

AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# IFLYTEK_APP_ID=xxx
# IFLYTEK_API_KEY=xxx
# IFLYTEK_API_SECRET=xxx

# ── Storage ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview

# ── Knowledge Base ──────────────────────────
KNOWLEDGE_DIR=./app/knowledge

# =====================================================
# Quick Start Guide
# =====================================================
# 
# 🚀 Recommended Setup (Best Cost-Performance):
#    1. Set LLM_PROVIDER=qwen
#    2. Get free API key: https://dashscope.console.aliyun.com/
#    3. Free quota: 1M tokens (90 days) for testing
#    4. Cost: ~¥0.58 per interview (48% cheaper than OpenAI)
#
# 📊 Cost Comparison (per interview session):
#    • Qwen (qwen3.5-plus + flash):  ¥0.58 ⭐ RECOMMENDED
#    • OpenAI (gpt-4o-mini):          ¥1.11
#    • Moonshot (kimi-k2.5):          ¥1.79
#    • Qwen Flash-only (budget):      ¥0.15
#
# 🎯 Model Assignment Strategy:
#    • Agent A (Gate Controller):  fast model (qwen-flash)
#    • Agent B/C (Interviewers):   strong model (qwen3.5-plus)
#    • Resume Parser:              strong model (qwen3.5-plus)
#    • Evaluator:                  fast model (qwen-flash)
#
# 🔄 Fallback Configuration:
#    Set LLM_FALLBACK_PROVIDERS=openai to use OpenAI as backup
#    Requires both QWEN_API_KEY and OPENAI_API_KEY
#
# ⚠️  Notes:
#    • Kimi K2.5 has fixed temperature=0.6 (not adjustable)
#    • Qwen models support 1M context (vs 262k for Kimi)
#    • Azure/iFlytek ASR settings are independent of LLM choice
#
# =====================================================
